/* Main stylesheet for MacDesktopWidget - Glassmorphism theme */

/* Global Styles */
* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #FFFFFF;
}

/* Main Window */
QMainWindow {
    background: transparent;
}

/* Central Widget - Glassmorphism Container */
.GlassContainer {
    background: rgba(20, 20, 30, 0.3);
    border: 1px solid rgba(100, 200, 255, 0.3);
    border-radius: 16px;
}

/* Title Bar */
.TitleBar {
    background: rgba(30, 30, 40, 0.5);
    border-bottom: 1px solid rgba(100, 200, 255, 0.2);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    padding: 8px;
}

.TitleLabel {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
}

/* Metric Widgets - Base */
.MetricWidget {
    background: rgba(40, 40, 50, 0.4);
    border: 1px solid rgba(100, 200, 255, 0.2);
    border-radius: 12px;
    padding: 12px;
}

.MetricLabel {
    color: rgba(255, 255, 255, 0.8);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.MetricValue {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 700;
}

.MetricSubValue {
    color: rgba(255, 255, 255, 0.6);
    font-size: 10px;
}

/* Progress Bars */
QProgressBar {
    background: rgba(60, 60, 70, 0.5);
    border: 1px solid rgba(100, 200, 255, 0.2);
    border-radius: 6px;
    text-align: center;
    height: 12px;
}

QProgressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00FF88,
        stop:0.6 #FFD700,
        stop:1 #FF4444
    );
}

/* Low usage - Green */
QProgressBar[value="0"]::chunk,
QProgressBar[value="1"]::chunk,
QProgressBar[value="2"]::chunk,
QProgressBar[value="3"]::chunk,
QProgressBar[value="4"]::chunk,
QProgressBar[value="5"]::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00FF88,
        stop:1 #00DD77
    );
}

/* Medium usage - Yellow */
QProgressBar[value="6"]::chunk,
QProgressBar[value="7"]::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #FFD700,
        stop:1 #FFAA00
    );
}

/* High usage - Red */
QProgressBar[value="8"]::chunk,
QProgressBar[value="9"]::chunk,
QProgressBar[value="10"]::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #FF4444,
        stop:1 #CC0000
    );
}

/* Process Table */
QTableWidget {
    background: rgba(30, 30, 40, 0.3);
    border: 1px solid rgba(100, 200, 255, 0.2);
    border-radius: 8px;
    gridline-color: rgba(100, 200, 255, 0.1);
    selection-background-color: rgba(100, 200, 255, 0.3);
}

QTableWidget::item {
    padding: 6px;
    border: none;
}

QTableWidget::item:selected {
    background: rgba(100, 200, 255, 0.3);
}

QHeaderView::section {
    background: rgba(40, 40, 50, 0.5);
    color: rgba(255, 255, 255, 0.9);
    padding: 8px;
    border: none;
    border-bottom: 1px solid rgba(100, 200, 255, 0.3);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
}

/* Scrollbar */
QScrollBar:vertical {
    background: rgba(30, 30, 40, 0.3);
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(100, 200, 255, 0.4);
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(100, 200, 255, 0.6);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* AI Suggestion Widget */
.AISuggestion {
    background: rgba(157, 78, 221, 0.3);
    border: 1px solid rgba(157, 78, 221, 0.5);
    border-radius: 8px;
    padding: 10px;
}

.AISuggestion[severity="warning"] {
    background: rgba(255, 152, 0, 0.3);
    border-color: rgba(255, 152, 0, 0.5);
}

.AISuggestion[severity="critical"] {
    background: rgba(255, 68, 68, 0.3);
    border-color: rgba(255, 68, 68, 0.5);
}

.AISuggestion[severity="info"] {
    background: rgba(33, 150, 243, 0.3);
    border-color: rgba(33, 150, 243, 0.5);
}

.SuggestionText {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 500;
}

/* Close Button */
QPushButton#closeButton {
    background: rgba(255, 68, 68, 0.3);
    border: 1px solid rgba(255, 68, 68, 0.5);
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
    color: #FFFFFF;
}

QPushButton#closeButton:hover {
    background: rgba(255, 68, 68, 0.5);
}

QPushButton#closeButton:pressed {
    background: rgba(255, 68, 68, 0.7);
}
